rules_version = '2';
// O navegador e o app NUNCA falam com o Firestore: só o servidor (conta de serviço, que ignora estas regras).
// Negar tudo aqui garante que um token de usuário roubado não leia nem escreva nada direto no banco.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
