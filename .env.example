# Copie para .env.local (NUNCA commite) e preencha. Veja docs/chaves-e-testes.md.
SITE_URL=http://localhost:8080
FIREBASE_PROJECT_ID=seu-projeto
# base64 do JSON da conta de serviço:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=
# chave RESTRITA do Stripe em modo de teste (rk_test_...)
STRIPE_SECRET_KEY=
# aparece quando você roda "stripe listen" (whsec_...)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ACTIVE=price_...
# ids de preço que valem como Pro (inclua os antigos ao trocar de preço), separados por vírgula
STRIPE_PRO_PRICES_ACCEPTED=
# secreta Ed25519 gerada por: php tools/gen-signing-keys.php
SIGNING_SECRET_KEY=
